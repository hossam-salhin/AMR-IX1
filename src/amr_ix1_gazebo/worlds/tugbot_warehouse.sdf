<?xml version='1.0' encoding='ASCII'?>
<sdf version='1.7'>

  <world name='industrial_inspection_world'>

    <!-- ========================================================= -->
    <!-- Physics                                                    -->
    <!-- ========================================================= -->

    <gravity>0 0 -9.8</gravity>

    <physics type='ode'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <max_contacts>10</max_contacts>
    </physics>


    <!-- ========================================================= -->
    <!-- Gazebo Core Systems                                        -->
    <!-- ========================================================= -->

    <plugin
      name='ignition::gazebo::systems::Physics'
      filename='libignition-gazebo-physics-system.so'/>

    <plugin
      name='ignition::gazebo::systems::UserCommands'
      filename='libignition-gazebo-user-commands-system.so'/>

    <plugin
      name='ignition::gazebo::systems::SceneBroadcaster'
      filename='libignition-gazebo-scene-broadcaster-system.so'/>

    <!-- Required for LiDAR / Camera / IMU sensors -->
    <plugin
      name='ignition::gazebo::systems::Sensors'
      filename='ignition-gazebo-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>


    <!-- ========================================================= -->
    <!-- Scene                                                      -->
    <!-- ========================================================= -->

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
    </scene>


    <!-- ========================================================= -->
    <!-- Lighting                                                   -->
    <!-- ========================================================= -->

    <light type='directional' name='sun'>

      <cast_shadows>0</cast_shadows>

      <pose>
        -5 -3 10 0 0 0
      </pose>

      <diffuse>
        1 1 1 1
      </diffuse>

      <specular>
        1 1 1 1
      </specular>

      <direction>
        0 0 -1
      </direction>

    </light>


    <!-- ========================================================= -->
    <!-- Ground                                                     -->
    <!-- ========================================================= -->

    <model name='ground_plane'>

      <static>true</static>

      <link name='link'>

        <collision name='collision'>

          <geometry>

            <plane>
              <normal>0.0 0.0 1</normal>
              <size>1 1</size>
            </plane>

          </geometry>

        </collision>

      </link>

      <pose>
        0 0 0 0 0 0
      </pose>

    </model>


    <!-- ========================================================= -->
    <!-- Warehouse                                                  -->
    <!-- ========================================================= -->

    <include>
  	<uri>model://warehouse</uri>
  	<name>warehouse</name>
  	<pose>0 0 -0.09 0 0 0</pose>
    </include>


    <!-- ========================================================= -->
    <!-- Charging Station                                           -->
    <!-- ========================================================= -->

    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/Tugbot-charging-station
      </uri>

      <name>
        charging_station
      </name>

      <pose>
        17.7822 -13.3305 -0.04 0 0 0
      </pose>

    </include>


    <!-- ========================================================= -->
    <!-- Shelves - Main Navigation Obstacles                        -->
    <!-- ========================================================= -->

    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf
      </uri>

      <name>
        shelf_0
      </name>

      <pose>
        -4.41528 -0.690987 0 0 0 0
      </pose>

    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf
      </uri>

      <name>
        shelf_1
      </name>

      <pose>
        -4.41528 2.30697 0 0 0 0
      </pose>

    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf
      </uri>

      <name>
        shelf_2
      </name>

      <pose>
        -4.41528 5.30708 0 0 0 0
      </pose>

    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf
      </uri>

      <name>
        shelf_3
      </name>

      <pose>
        5.60144 8.34352 0 0 0 0
      </pose>

    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf
      </uri>

      <name>
        shelf_4
      </name>

      <pose>
        5.60144 5.30708 0 0 0 0
      </pose>

    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf
      </uri>

      <name>
        shelf_5
      </name>

      <pose>
        5.60144 2.30697 0 0 0 0
      </pose>

    </include>


    <!-- ========================================================= -->
    <!-- Large Shelves                                              -->
    <!-- ========================================================= -->

    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf_big
      </uri>

      <name>
        shelf_big_0
      </name>

      <pose>
        -9.34177 -13.5598 0 0 0 0
      </pose>

    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf_big
      </uri>

      <name>
        shelf_big_1
      </name>

      <pose>
        13.9821 15.319 0 0 0 0
      </pose>

    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf_big
      </uri>

      <name>
        shelf_big_2
      </name>

      <pose>
        6.19777 -12.9647 0 0 0 0
      </pose>

    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf_big
      </uri>

      <name>
        shelf_big_3
      </name>

      <pose>
        0.594376 -12.9647 0 0 0 0
      </pose>

    </include>


    <!-- ========================================================= -->
    <!-- Pallets                                                    -->
    <!-- ========================================================= -->

    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/pallet_box_mobile
      </uri>

      <name>
        pallet_box_mobile
      </name>

      <pose>
        4.4161 14.6952 0.01 0 0 0
      </pose>

    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/pallet_box_mobile
      </uri>

      <name>
        pallet_box_mobile_0
      </name>

      <pose>
        4.45415 13.6212 0.01 0 0 0
      </pose>

    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/pallet_box_mobile
      </uri>

      <name>
        pallet_box_mobile_1
      </name>

      <pose>
        4.4468 12.229 0.01 0 0 0
      </pose>

    </include>


    


  </world>

</sdf>
