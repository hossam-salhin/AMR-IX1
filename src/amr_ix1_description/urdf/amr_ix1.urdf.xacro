<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr_ix1">

  <!-- ================================================================
       AMR-IX1 Inspection Robot — top-level URDF/Xacro
       Maintainer: Hossam
       License: Apache-2.0

       Arguments (defaults keep the old behaviour = Ignition simulation):
         hardware     sim | mock | real      (default: sim)
         use_thermal  true | false           (default: true; simulation only)
       Example:  xacro amr_ix1.urdf.xacro hardware:=mock
  ================================================================ -->
  <xacro:arg name="hardware" default="sim"/>
  <xacro:arg name="use_thermal" default="true"/>

  <xacro:include filename="$(find amr_ix1_description)/urdf/amr_ix1_base.xacro"/>
  <xacro:include filename="$(find amr_ix1_description)/urdf/amr_ix1_ros2_control.xacro"/>
  <xacro:include filename="$(find amr_ix1_description)/urdf/amr_ix1_gazebo.xacro"/>

  <xacro:amr_ix1_ros2_control hardware="$(arg hardware)"/>

  <xacro:if value="${'$(arg hardware)' == 'sim'}">
    <xacro:amr_ix1_gazebo use_thermal="$(arg use_thermal)"/>
  </xacro:if>

</robot>
